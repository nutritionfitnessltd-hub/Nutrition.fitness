# No secrets in Git, generated HTML, or browser JavaScript. All below are server-only.
SITE_URL=
# Exact additional HTTPS preview origins, comma-separated; never a wildcard.
NUFI_ALLOWED_ORIGINS=

# A DEDICATED NUFI database/auth project. Do not reuse another business’s project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set true only after configuring the OTP email template, sender, limits and CAPTCHA.
NUFI_EMAIL_OTP_READY=false
NUFI_AUTH_CAPTCHA_READY=false

# Nutrition.Fitness GoHighLevel sub-account and actual custom-field IDs.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_PROGRAMME_FIELD_ID=
GHL_QUIZ_FIELD_ID=
GHL_TRIAL_FIELD_ID=
GHL_API_VERSION=v3

# Comma-separated verified Supabase user UUIDs. Not editable user metadata.
NUFI_ADMIN_USER_IDS=
# Long random secret for a scheduled /api/crm-sync request.
CRON_SECRET=
# Remains false until the real NUFI app checks the entitlement ledger and is tested.
NUFI_APP_ACCESS_READY=false

# Existing optional TEST-ONLY checkout adapter. No live payment implementation.
STRIPE_TEST_SECRET_KEY=
